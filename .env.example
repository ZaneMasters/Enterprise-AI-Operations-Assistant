# Entorno de ejecución
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Rutas de almacenamiento local
VECTOR_DB_PATH=./data/vectorstore
SQLITE_DB_PATH=./data/history.db
REQUESTS_DB_PATH=./data/requests_db.json

# Configuración de LLM y Embeddings
# Proveedor: "mock", "bedrock" o "openai"
LLM_PROVIDER=mock
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_REGION=us-east-1

# Credenciales AWS (opcional para desarrollo local si se usa provider mock o perfil IAM)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

# OpenAI (opcional para pruebas si se usa provider openai)
# OPENAI_API_KEY=
